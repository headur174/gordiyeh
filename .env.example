# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DB_ENCRYPTION_KEY: Cryptographically secure 32-byte encryption key for AES-256-GCM zero-plaintext at-rest storage.
# FORMAT: Must be a 64-character hex string (generated via 'openssl rand -hex 32') OR a passphrase >= 32 characters.
# DO NOT commit real keys to source control. Never use example/placeholder keys in production.
# Generate a new production key using:
#   openssl rand -hex 32
DB_ENCRYPTION_KEY=""

# DB_ENCRYPTION_KEY_ID: Active Key ID for versioned encryption payloads (e.g. k1, k2).
DB_ENCRYPTION_KEY_ID="k1"

# COMMERCE_DB_PATH: Path to the SQLite database file.
# Defaults to data/commerce.db. In tests, use an isolated temporary path.
# In persistent container platforms (e.g., Liara / Docker), mount a persistent volume (e.g., /data/commerce.db).
COMMERCE_DB_PATH="data/commerce.db"

# PORT: Web server listening port (defaults to 3000). PaaS platforms like Liara provide this automatically.
PORT="3000"

# NODE_ENV: Runtime environment (development | production | test).
NODE_ENV="production"

# WEBHOOK_ALLOW_LOOPBACK: Only enable for local dev/testing where webhooks point to localhost (true | false).
# Must be false in production to enforce strict SSRF guards.
WEBHOOK_ALLOW_LOOPBACK="false"

# DB_ENCRYPTION_KEYRING: Optional JSON map of older keys for zero-downtime rotation.
# Format: {"k1":"64-hex-key-1","k2":"64-hex-key-2"}
# DB_ENCRYPTION_KEYRING=""
