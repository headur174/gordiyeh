# Gordiyeh (گُردیه) — Production & Liara Environment Variables Template
# Copy values into your server/Liara environment variables panel. NEVER commit real secrets.

# 1. Runtime Mode & Networking
NODE_ENV="production"
PORT="3000"
APP_URL="https://gordiyeh.ir"
# TRUST_PROXY="1"

# 2. Administrator Security (REQUIRED IN PRODUCTION — fail-closed)
# Generate ADMIN_SECRET_KEY (min 24 chars): openssl rand -hex 24
# Generate ADMIN_PASSWORD (min 12 chars):   openssl rand -base64 16
ADMIN_SECRET_KEY=""
ADMIN_PASSWORD=""
# Optional dedicated preview token (defaults to HMAC derived from ADMIN_SECRET_KEY)
# DRAFT_PREVIEW_TOKEN=""

# 3. Persistent Databases & Encryption (REQUIRED IN PRODUCTION)
# Point COMMERCE_DB_PATH to the Liara persistent disk mounted at /data
COMMERCE_DB_PATH="/data/commerce.db"
# UPLOADS_DIR="/data/uploads"
# Generate DB_ENCRYPTION_KEY (64 hex chars): openssl rand -hex 32
DB_ENCRYPTION_KEY=""
DB_ENCRYPTION_KEY_ID="k1"
# Optional key rotation map: {"k1":"...","k2":"..."}
# DB_ENCRYPTION_KEYRING=""

# PostgreSQL connection string for durable CMS documents/articles/revisions (Liara Managed PostgreSQL)
# DATABASE_URL="postgres://user:pass@host:5432/gordiyeh"

# 4. Payment Gateway Integration (Zarinpal, Zibal, IDPay, Sandbox)
# PAYMENT_GATEWAY_SECRET (generate with: openssl rand -hex 32) is REQUIRED in production for webhook callbacks
PAYMENT_GATEWAY_SECRET=""
PAYMENT_PROVIDER="zarinpal"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"

# 5. Outgoing Webhook Security
# Keep false in production to block SSRF to loopback/private IPs
WEBHOOK_ALLOW_LOOPBACK="false"

# 6. Gemini AI Assistant & Content Studio (Optional if AI features enabled)
GEMINI_API_KEY=""

# 7. SMS Gateway Integration (SMS.ir, Kavenegar, MeliPayamak, IPPanel, Custom)
# You can set via env vars OR encrypted in /admin Settings
SMS_PROVIDER="smsir"
SMSIR_API_KEY=""
SMSIR_TEMPLATE_ID=""
SMS_LINE_NUMBER=""

# 8. Marketplaces (Torob / Emalls / Digikala Seller Center) & Canonical SITE_URL
SITE_URL="https://gordiyeh.ir"
DIGIKALA_SELLER_API_KEY=""
DIGIKALA_SELLER_BASE_URL="https://seller.digikala.com/api/v1"

# 9. Social Auto-Publishing (Telegram, Bale, Eitaa, Instagram Meta Graph API)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
BALE_BOT_TOKEN=""
BALE_CHAT_ID=""
EITAA_API_TOKEN=""
EITAA_CHAT_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_IG_USER_ID=""
