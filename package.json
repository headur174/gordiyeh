{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:seo": "tsx test_seo.ts",
    "test:cms": "tsx test_cms_suite.ts",
    "test:e2e": "tsx test_e2e_full.ts",
    "test:security": "tsx test_security.ts",
    "test:hardening": "tsx test_resilience_hardening.ts",
    "test:integrations": "tsx test_integrations.ts",
    "test:all": "npm run test:security && npm run test:e2e && npm run test:seo && npm run test:cms && npm run test:hardening && npm run test:integrations"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
